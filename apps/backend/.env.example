# ----- Server -----
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (your storefront + admin URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----- Database -----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# ----- Auth (JWT) -----
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=7d
# Optional dedicated secret for hashing password-reset OTPs (defaults to JWT_SECRET)
OTP_SECRET=replace-with-a-long-random-secret

# ----- Razorpay (wallet recharge) -----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret

# ----- Email (password reset OTP) -----
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your-gmail-app-password

# ----- AWS S3 (media storage) -----
AWS_ACCESS_S3_KEY_ID=
AWS_SECRET_S3_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=

# ----- Cloudinary -----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Google Gemini (AI ticket suggestions) -----
GEMINI_API_KEY=
