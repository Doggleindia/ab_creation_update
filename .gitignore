# ---- Dependencies ----
node_modules/
**/node_modules/
.pnp
.pnp.js
# Lockfile omitted: a Windows-generated npm lockfile breaks Linux CI builds via
# the npm optional-deps bug (Rollup native binaries, npm/cli#4828). Each env
# resolves its own platform binaries on install.
/package-lock.json

# ---- Build / output ----
**/.next/
**/out/
**/build/
**/dist/
*.tsbuildinfo
next-env.d.ts

# ---- Env & secrets (never commit; keep .env.example) ----
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ---- Logs ----
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Caches / coverage ----
.cache/
coverage/
.eslintcache

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/
